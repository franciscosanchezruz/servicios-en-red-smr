# ==============================================================================
# /etc/postfix/main.cf - Configuración Oficial Postfix (smr.lan)
# Libro: 'Servicios en Red' - Francisco Sánchez Ruz (Editorial Monsálvez)
# ==============================================================================
smtpd_banner =  ESMTP Postfix (Debian/GNU)
biff = no
append_dot_mydomain = no
readme_directory = no

myhostname = server.smr.lan
mydomain = smr.lan
myorigin = 
mydestination = , localhost., localhost, 
relayhost = 
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128 10.0.0.0/24
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = ipv4

# Formato Maildir por usuario
home_mailbox = Maildir/
